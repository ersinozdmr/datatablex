{
  "name": "datatablex",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deps": "pnpm install --prefer-offline --reporter=silent",
    "build": "pnpm run deps && turbo run build",
    "typecheck": "pnpm run deps && turbo run typecheck",
    "lint": "pnpm run deps && turbo run lint",
    "test": "pnpm run deps && turbo run test",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "dev": "pnpm run deps && turbo run dev",
    "changeset": "changeset",
    "release": "turbo run build && changeset publish",
    "check:language": "node scripts/check-language.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "smoke": "node scripts/smoke-packages.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
