{
  "name": "@datatablex/antd",
  "version": "0.1.0-rc.1",
  "description": "Ant Design v5 components for DataTableX: <DataTable>, a filter bar and an advanced filter builder, a column menu and an export menu.",
  "keywords": [
    "datatable",
    "data-table",
    "antd",
    "ant-design",
    "react",
    "table",
    "server-side",
    "filter",
    "export"
  ],
  "author": "Ersin Ozdemir (https://github.com/ersinozdmr)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ersinozdmr/datatablex.git",
    "directory": "packages/antd"
  },
  "homepage": "https://github.com/ersinozdmr/datatablex/tree/main/packages/antd#readme",
  "bugs": {
    "url": "https://github.com/ersinozdmr/datatablex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@datatablex/core": "workspace:>=0.1.0-rc.0 <1.0.0",
    "@datatablex/react": "workspace:>=0.1.0-rc.0 <1.0.0",
    "antd": "^5.20.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@datatablex/core": "workspace:*",
    "@datatablex/react": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "antd": "^5.22.5",
    "exceljs": "^4.4.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
