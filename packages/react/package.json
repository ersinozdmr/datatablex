{
  "name": "@datatablex/react",
  "version": "0.1.0",
  "description": "Headless useDataTable hook for DataTableX, with REST and local data sources, URL sync and export. UI library independent; see @datatablex/antd for Ant Design components.",
  "keywords": [
    "datatable",
    "data-table",
    "react",
    "hook",
    "headless",
    "table",
    "server-side",
    "pagination",
    "filter",
    "export"
  ],
  "author": "Ersin Ozdemir (https://github.com/ersinozdmr)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ersinozdmr/datatablex.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/ersinozdmr/datatablex/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/ersinozdmr/datatablex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./filter-model": {
      "import": {
        "types": "./dist/filter-model.d.ts",
        "default": "./dist/filter-model.js"
      },
      "require": {
        "types": "./dist/filter-model.d.cts",
        "default": "./dist/filter-model.cjs"
      }
    },
    "./excel": {
      "import": {
        "types": "./dist/excel.d.ts",
        "default": "./dist/excel.js"
      },
      "require": {
        "types": "./dist/excel.d.cts",
        "default": "./dist/excel.cjs"
      }
    },
    "./pdf": {
      "import": {
        "types": "./dist/pdf.d.ts",
        "default": "./dist/pdf.js"
      },
      "require": {
        "types": "./dist/pdf.d.cts",
        "default": "./dist/pdf.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "exceljs": "^4.4.0",
    "pdfmake": "0.2.20",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "pdfmake": {
      "optional": true
    }
  },
  "dependencies": {
    "@datatablex/core": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.19.0",
    "@types/pdfmake": "0.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "exceljs": "^4.4.0",
    "jsdom": "^29.1.1",
    "pdfmake": "0.2.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
