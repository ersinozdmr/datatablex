{
  "name": "@datatablex/core",
  "version": "0.1.0",
  "description": "DataTableX wire contract: query/result types and zero-dependency helpers shared by frontend and backend.",
  "keywords": [
    "datatable",
    "data-table",
    "table",
    "query",
    "filter",
    "sorting",
    "pagination",
    "typescript"
  ],
  "author": "Ersin Ozdemir (https://github.com/ersinozdmr)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ersinozdmr/datatablex.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ersinozdmr/datatablex/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ersinozdmr/datatablex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {},
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
