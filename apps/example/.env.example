# Works with this connection string after `pnpm --filter example db:up` (see docker-compose.yml).
DATABASE_URL=postgres://datatablex:datatablex@localhost:55432/datatablex_example
PORT=3000
# Interface to listen on (default localhost). A non-loopback host with NODE_ENV=production requires ALLOW_INSECURE_DEMO=1.
# HOST=localhost
# CORS is off by default; if needed, a comma-separated list of origins.
# CORS_ORIGIN=http://localhost:5173
