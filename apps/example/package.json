{
  "name": "example",
  "private": true,
  "version": "0.0.0",
  "description": "DataTableX example application: a Fastify API on a real PostgreSQL database plus a React and Ant Design client.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "echo \"[example] no unit tests; see test:e2e\" && exit 0",
    "test:e2e": "pnpm run db:migrate && pnpm run db:seed && playwright test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "playwright:install": "playwright install --with-deps chromium",
    "bench:export": "node --expose-gc --import tsx scripts/bench-export.ts"
  },
  "dependencies": {
    "@datatablex/antd": "workspace:*",
    "@datatablex/core": "workspace:*",
    "@datatablex/fastify": "workspace:*",
    "@datatablex/react": "workspace:*",
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^10.1.12",
    "antd": "^6.7.2",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "kysely": "^0.28.20",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.11.10",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
